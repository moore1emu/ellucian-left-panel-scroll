{
  "manifest_version": 3,
  "name": "Ellucian Left Panel Scroll",
  "version": "1.15.1",
  "description": "Adds independent scrolling, adjustable panels, search, and pinned package and pipeline favorites to Ellucian Integration pages.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "20": "icons/icon20.png",
      "24": "icons/icon24.png",
      "28": "icons/icon28.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Ellucian Left Panel Scroll settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://experience-test.elluciancloud.com/*",
        "https://experience.elluciancloud.com/*"
      ],
      "js": [
        "page-index.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://experience-test.elluciancloud.com/*",
        "https://experience.elluciancloud.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js",
        "search.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
